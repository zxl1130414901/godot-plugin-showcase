{
  "name": "godot-plugin-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Godot 插件开源项目对比站 · 单文件离线版",
  "scripts": {
    "dev": "vite",
    "data": "node scripts/build-data.mjs",
    "build": "node scripts/build-data.mjs && npm run typecheck && vite build && node scripts/inline.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
